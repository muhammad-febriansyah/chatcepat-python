# Flask API Configuration
PORT=5000
DEBUG=false

# API Security
# Generate key: python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEY=your-secret-api-key-change-this
# Origin of the Laravel app that calls this API (CORS restriction)
ALLOWED_ORIGIN=https://your-domain.com

# Google Maps API Key (Get from: https://console.cloud.google.com/apis/credentials)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Scraper Mode: "api" or "selenium"
# api = Gunakan Google Places API (Recommended, lebih stabil, tidak di-block)
# selenium = Gunakan Selenium scraping (Free tapi bisa di-block)
SCRAPER_MODE=api

# Proxy Configuration (optional, untuk mode selenium)
USE_PROXY=false
# PROXY_SERVER=ip:port
# PROXY_USER=username
# PROXY_PASS=password

# Scraper Configuration
MAX_RESULTS_LIMIT=100
DEFAULT_MAX_RESULTS=20
